<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <LinearLayout
        android:id="@+id/headerEditar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#C72A2A"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/btnVolverEditar"
            android:layout_width="71dp"
            android:layout_height="50dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/flecha" />

        <TextView
            android:id="@+id/txtTituloEditar"
            android:layout_width="196dp"
            android:layout_height="35dp"
            android:layout_marginStart="20dp"
            android:paddingTop="5dp"
            android:text="Editar Precio"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogoEditar"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:src="@drawable/logo_cinemax"
        app:layout_constraintTop_toBottomOf="@id/headerEditar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Campo Descripción -->
    <EditText
        android:id="@+id/edtDescripcionPrecio"
        android:layout_width="300dp"
        android:layout_height="45dp"
        android:hint="Descripción"
        android:inputType="text"
        android:background="@drawable/edittext_oval"
        app:layout_constraintTop_toBottomOf="@id/imgLogoEditar"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <EditText
        android:id="@+id/edtValorPrecio"
        android:layout_width="300dp"
        android:layout_height="45dp"
        android:hint="Valor"
        android:inputType="numberDecimal"
        android:background="@drawable/edittext_oval"
        app:layout_constraintTop_toBottomOf="@id/edtDescripcionPrecio"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnActualizarPrecio"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Actualizar Precio"
        android:backgroundTint="#C72A2A"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/edtValorPrecio"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/btnCancelarEditar"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Cancelar"
        android:backgroundTint="#888888"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnActualizarPrecio"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
