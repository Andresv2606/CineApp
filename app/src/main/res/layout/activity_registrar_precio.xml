<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".RegistrarPrecio">
    >
    <ImageButton
        android:id="@+id/btnVolverPrecio"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="48dp"
        android:adjustViewBounds="true"
        android:background="@android:color/transparent"
        android:contentDescription="Volver"
        android:scaleType="fitCenter"
        android:src="@drawable/flecha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTituloPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Precio"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <ImageView
        android:id="@+id/imgLogoPrecio"
        android:layout_width="200dp"
        android:layout_height="190dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/logo_cinemax"
        app:layout_constraintTop_toBottomOf="@id/txtTituloPrecio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <EditText
        android:id="@+id/edtDescripcionPrecio"
        android:layout_width="300dp"
        android:layout_height="45dp"
        android:hint="Descripción"
        android:inputType="text"
        android:background="@drawable/edittext_oval"
        app:layout_constraintTop_toBottomOf="@id/imgLogoPrecio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/edtValorPrecio"
        android:layout_width="300dp"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:hint="Valor"
        android:inputType="number"
        android:background="@drawable/edittext_oval"
        app:layout_constraintTop_toBottomOf="@id/edtDescripcionPrecio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/btnRegistrarPrecio"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:text="Registrar Precio"
        android:backgroundTint="#C72A2A"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/edtValorPrecio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
