<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- BARRA SUPERIOR ROJA -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#D50000">

        <!-- TÍTULO CENTRADO -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESERVAR"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>

        <!-- FLECHA PEGADA AL TEXTO RESERVAR -->

        <!-- LOGO AL LADO DERECHO -->

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="65dp"
            android:layout_height="52dp"
            android:layout_marginEnd="38dp"
            android:layout_toStartOf="@id/txtTitulo"
            android:adjustViewBounds="true"
            android:padding="8dp"
            android:src="@drawable/flecha" />

        <ImageView
            android:id="@+id/logoCine"
            android:layout_width="120dp"
            android:layout_height="65dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:src="@drawable/logo_cinemax"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"/>
    </RelativeLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD PRINCIPAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="#FAFAFA"
                android:elevation="5dp"
                android:layout_margin="12dp"
                android:clipToPadding="false">

                <!-- Película -->
                <TextView
                    android:text="Película:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/txtPelicula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/text_primary"/>

                <!-- Cine -->
                <TextView
                    android:text="Cine:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/txtCine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/text_primary"/>

                <!-- Sala -->
                <TextView
                    android:text="Sala:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/txtSala"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/text_primary"/>

                <!-- Hora -->
                <TextView
                    android:text="Hora:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/txtHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/text_primary"/>

                <!-- Precio -->
                <TextView
                    android:text="Precio por boleto:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/txtPrecioUnitario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/text_primary"/>

                <!-- Cantidad -->
                <TextView
                    android:text="Cantidad:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <!-- Total -->
                <EditText
                    android:id="@+id/inputCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="Ej: 2"
                    android:inputType="number"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:text="Total a pagar:"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="$0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="35dp"
                    android:textColor="@color/text_primary"/>

                <!-- BOTÓN -->
                <Button
                    android:id="@+id/btnConfirmarReserva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONFIRMAR RESERVA"
                    android:padding="16dp"
                    android:textSize="18sp"
                    android:backgroundTint="#D50000"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
